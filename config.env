# Configuración de cámara para Kz (sourced por los scripts)
# Rutas relativas a KZ_HOME (este directorio)
#
# Overrides por máquina (path MEGA, etc.): config.local.env (gitignored).
# Ver config.local.env.example.

# Playbook (solo si hace falta override; el watch resuelve solo ~/Workspace/playbook)
# Dispositivo V4L2 (C920 suele ser video0=stream, video1=metadata)
KZ_DEVICE="${KZ_DEVICE:-/dev/video0}"

# Resolución de captura (MJPEG en C920: 1280x720 o 1920x1080 van bien)
KZ_RESOLUTION="${KZ_RESOLUTION:-1280x720}"

# Formato de entrada preferido (mjpeg = más rápido/ligero en USB)
KZ_INPUT_FORMAT="${KZ_INPUT_FORMAT:-mjpeg}"

# Segundos de calentamiento antes del frame (autofocus/exposición)
KZ_WARMUP_SEC="${KZ_WARMUP_SEC:-0.8}"

# Intervalo por defecto de cam-watch (segundos)
KZ_WATCH_INTERVAL="${KZ_WATCH_INTERVAL:-5}"

# Cuántos frames descarta ffmpeg antes de guardar (estabilidad)
KZ_SKIP_FRAMES="${KZ_SKIP_FRAMES:-3}"
