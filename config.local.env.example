# Copia a config.local.env y ajusta el path de MEGA en esta máquina.
#   cp -n config.local.env.example config.local.env
#
# config.local.env está en .gitignore (cada PC tiene el suyo).
# Guía paso a paso (otra casa, fotos, rarezas): MEMORY-MEGA.md

# Raíz del cliente MEGA en esta máquina (ejemplos):
#   /home/lalo/MEGA
#   /home/lalo/MEGA Sync
#   /media/lalo/MEGA
KZ_MEGA_ROOT="/home/lalo/MEGA"

# Opcional: carpeta de memoria dentro de MEGA (default: ${KZ_MEGA_ROOT}/kz-memory)
# KZ_MEMORY_DIR="/home/lalo/MEGA/kz-memory"
